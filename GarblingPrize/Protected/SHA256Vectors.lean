import GarblingPrize.Protected.SHA256

namespace GarblingPrize.Protected.SHA256

/-! FIPS 180-4 conformance vectors for the native executable self-test. -/

def expectedEmpty : Bytes 32 := #v[
  0xe3, 0xb0, 0xc4, 0x42, 0x98, 0xfc, 0x1c, 0x14,
  0x9a, 0xfb, 0xf4, 0xc8, 0x99, 0x6f, 0xb9, 0x24,
  0x27, 0xae, 0x41, 0xe4, 0x64, 0x9b, 0x93, 0x4c,
  0xa4, 0x95, 0x99, 0x1b, 0x78, 0x52, 0xb8, 0x55
]

def expectedAbc : Bytes 32 := #v[
  0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
  0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,
  0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c,
  0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad
]

def repeatedA (count : Nat) : ByteArray :=
  ByteArray.mk (Array.replicate count (UInt8.ofNat 0x61))

def expectedA55 : Bytes 32 := #v[
  0x9f, 0x43, 0x90, 0xf8, 0xd3, 0x0c, 0x2d, 0xd9,
  0x2e, 0xc9, 0xf0, 0x95, 0xb6, 0x5e, 0x2b, 0x9a,
  0xe9, 0xb0, 0xa9, 0x25, 0xa5, 0x25, 0x8e, 0x24,
  0x1c, 0x9f, 0x1e, 0x91, 0x0f, 0x73, 0x43, 0x18
]

def expectedA56 : Bytes 32 := #v[
  0xb3, 0x54, 0x39, 0xa4, 0xac, 0x6f, 0x09, 0x48,
  0xb6, 0xd6, 0xf9, 0xe3, 0xc6, 0xaf, 0x0f, 0x5f,
  0x59, 0x0c, 0xe2, 0x0f, 0x1b, 0xde, 0x70, 0x90,
  0xef, 0x79, 0x70, 0x68, 0x6e, 0xc6, 0x73, 0x8a
]

def expectedA64 : Bytes 32 := #v[
  0xff, 0xe0, 0x54, 0xfe, 0x7a, 0xe0, 0xcb, 0x6d,
  0xc6, 0x5c, 0x3a, 0xf9, 0xb6, 0x1d, 0x52, 0x09,
  0xf4, 0x39, 0x85, 0x1d, 0xb4, 0x3d, 0x0b, 0xa5,
  0x99, 0x73, 0x37, 0xdf, 0x15, 0x46, 0x68, 0xeb
]

def fipsVectorsPass : Bool :=
  hash "".toUTF8 == expectedEmpty &&
    hash "abc".toUTF8 == expectedAbc &&
    hash (repeatedA 55) == expectedA55 &&
    hash (repeatedA 56) == expectedA56 &&
    hash (repeatedA 64) == expectedA64

end GarblingPrize.Protected.SHA256

namespace GarblingPrize.Protected.HMACSHA256

/-! RFC-compatible HMAC-SHA256 regression vector with a 32-byte zero key. -/

def expectedZeroKeyAbc : Bytes 32 := #v[
  0xfd, 0x7a, 0xdb, 0x15, 0x2c, 0x05, 0xef, 0x80,
  0xdc, 0xcf, 0x50, 0xa1, 0xfa, 0x4c, 0x05, 0xd5,
  0xa3, 0xec, 0x6d, 0xa9, 0x55, 0x75, 0xfc, 0x31,
  0x2a, 0xe7, 0xc5, 0xd0, 0x91, 0x83, 0x63, 0x51
]

def vectorsPass : Bool :=
  hash (Bytes.zero 32) "abc".toUTF8 == expectedZeroKeyAbc

end GarblingPrize.Protected.HMACSHA256
